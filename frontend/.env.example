# Copia este archivo como .env y ajusta los valores.
# El .env real NO se sube al repositorio (esta en .gitignore).
# En Vercel define VITE_API_URL en la interfaz (Settings → Environment Variables).

# En produccion apunta a la URL del backend desplegado, ej:
#   VITE_API_URL=https://tu-backend.onrender.com/api
VITE_API_URL=http://localhost:3001/api
VITE_APP_TITULO=CatalogoBulk