# ================================================================
# Backend — CatalogoBulk
# Copia este archivo como .env (o define estas variables en el hosting).
# ================================================================

# Puertos: en hosting (Render/Railway) usan la variable PORT que te dan.
PORT=3000

# MongoDB: local (docker) o MongoDB Atlas
#   Local:   mongodb://localhost:27017/catalogobulk
#   Atlas:   mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/catalogobulk
MONGO_URI=mongodb://localhost:27017/catalogobulk

# ----------------------------------------------------------------
# Redis (OPCIONAL). El backend funciona sin Redis.
#   Opcion A - Upstash (gratis): copia la URL tipo rediss://...
#   Opcion B - Render Redis / local: define REDIS_HOST y REDIS_PORT
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
# ----------------------------------------------------------------

# Origen permitido por CORS (separar varios con coma).
# En produccion pon la URL del frontend desplegado, ej:
#   CORS_ORIGIN=https://tu-proyecto.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=cambiar_en_produccion
JWT_EXPIRES_IN=1h

MAX_FILE_SIZE_MB=50
BATCH_SIZE=500
CACHE_TTL_SECONDS=300
IMPORT_ERRORS_CAP=1000